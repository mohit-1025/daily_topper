# ---------------------------------------------------------------------------
# Daily Topper — environment template
# Copy to `.env` (or `.env.local`) and fill in what you need.
# Every value is optional: with no keys the app runs fully in local Guest mode
# and every AI feature falls back to a deterministic offline generator.
# ---------------------------------------------------------------------------

# --- AI (client switch only — never put a provider key in a VITE_ variable) --
# Set to true to call the serverless route below instead of the local mock.
VITE_AI_ENABLED=false
# Thin serverless route that holds the provider key. Defaults to /api/ai.
VITE_AI_ENDPOINT=/api/ai
# Optional audio/video transcription endpoint (mock transcript if unset).
VITE_TRANSCRIBE_ENDPOINT=

# --- AI provider (server-side only — used by api/ai.ts and the Vite proxy) ---
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Clerk (email/password auth + verified emails) -------------------------
# Publishable key is safe for the browser. With it unset the app falls back
# to local accounts and guest mode (zero-setup demo).
VITE_CLERK_PUBLISHABLE_KEY=
# Server-side only. Never expose this in a VITE_ variable or client bundle.
CLERK_SECRET_KEY=

# --- Supabase (optional remote repository) ----------------------------------
# Leave blank to use the local adapter (localStorage + IndexedDB).
# With Clerk configured, Supabase trusts Clerk session tokens through
# Authentication → Third-Party Auth; see the README for the schema + RLS SQL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
